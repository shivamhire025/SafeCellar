# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — required for signup (org + profile creation)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SafeCellar

# Demo mode: true = in-memory data (default). false = live Supabase (requires keys above).
NEXT_PUBLIC_DEMO_MODE=true

# Local Supabase (after `npm run supabase:start` — copy keys from `npm run supabase:status`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from status>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from status>
# NEXT_PUBLIC_DEMO_MODE=false

# Marcus demo account (production) — run: npm run seed:marcus
# MARCUS_DEMO_PASSWORD=CascadeCreek2025!
# SEED_MARCUS_SECRET=random-long-string  # for POST /api/admin/seed-marcus on Vercel
